# cache/*, а не cache/: git не заходить у виключений каталог, тож !*.keep_folder
# нижче не зміг би повернути маркер. А каталог мусить існувати у свіжому клоні —
# dev-оверрайд монтує його бінд-маунтом, і відсутній шлях docker створює від
# root, після чого застосунок не може створити в ньому cache/css.
cache/*

/Okay/log/*
config/config.local.php
design/*/lang/local.*.php
#design/*/css/theme-settings.css
!*.keep_folder
!*.htaccess
.phpunit.result.cache
# robots.txt навмисно у репозиторії: статику в корені віддає nginx зі свого образу,
# і smoke-prod.sh пробує саме цей файл, щоб довести, що дерево застосунку на місці.
# Правило, яке ігнорувало його тут, було мертвим (файл уже відстежується), зате
# приглушувало його в git-панелі редактора і зробило б випадкове
# `git rm --cached` незворотним.
dev/docker-compose.local.yml

# Claude Code local settings
.claude/settings.local.json
.worktrees/
