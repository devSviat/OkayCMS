#php_flag display_errors on
#php_flag display_startup_errors on
#php_value session.cookie_httponly true
#php_value memory_limit 256M
AddDefaultCharset UTF-8
ErrorDocument 404 /404
RewriteEngine on
#RewriteBase /

# Лістинги директорій не потрібні ніде: вони видають структуру дерева навіть
# там, де кожен окремий файл закритий.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ───────────────────────── Білий список ─────────────────────────
#
# Корінь сайту — усе дерево застосунку. На звичайному хостингу (Apache +
# mod_php) цей файл — єдиний важіль: доступу до конфігу віртуального хоста
# там немає. Тому логіка та сама, що й у docs/nginx/nginx.conf: перелічується
# те, що віддається, а не те, що заборонено.
#
# Ключове — останнє правило блоку: усе, що не збіглося з жодним дозволом,
# переписується на index.php НЕЗАЛЕЖНО від того, чи файл існує на диску. До
# цього фінальне правило файлу віддавало у фронт-контролер лише неіснуючі
# шляхи (`!-f`), тож усе, що фізично лежить у дереві, віддавалось як є:
# 1DB_changes/okay_clean.sql, dev/.env, composer.json, ./ok, Okay/**, tests/**.
#
# Переписування на index.php ще й не дає виконатись стороннім .php: mod_rewrite
# відпрацьовує на етапі відображення URL у файл, до вибору обробника, тож
# compiled/*.tpl.php і Okay/**.php до mod_php не доходять.
#
# Умови зіставляються з $1 — шляхом відносно каталогу з цим .htaccess, а не з
# %{REQUEST_URI}: інакше встановлення в підкаталог (site.com/shop/) ламало б
# кожне правило.

# Дерево залежностей і службові каталоги — 403 одразу, без переписування.
RewriteRule .*(\.git/|\.idea|\.gitignore).* - [F]
RewriteRule ^vendor/.* - [F]

# Дерева адмінки, які не є ані статикою, ані точками входу.
RewriteRule ^backend/(Controllers|Helpers|Requests|Entities)/ index.php [L,QSA]
RewriteRule ^backend/lang/ index.php [L,QSA]
RewriteRule ^backend/design/compiled/ index.php [L,QSA]
RewriteRule ^backend/design/js/filemanager/config/ index.php [L,QSA]

# Під backend/design/ з диска віддається лише статика за розширенням, плюс
# .php двох справжніх точок входу. Без цього віддавались 109 шаблонів .tpl,
# .htaccess і сміття вендорних JS-бібліотек (README, .sh, .yml, Thumbs.db).
RewriteCond $1 !\.(css|js|map|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot|html?|json)$ [NC]
RewriteCond $1 !^backend/design/js/(filemanager|admintooltip)/.+\.php$ [NC]
RewriteRule ^(backend/design/.*)$ index.php [L,QSA]

# Вихідні файли до ресайзу не публічні.
RewriteRule ^files/originals/ index.php [L,QSA]

# Усе, що не збіглося з жодним дозволом нижче, — у фронт-контролер.
RewriteCond $1 !^(robots\.txt|favicon\.ico|index\.php)$
RewriteCond $1 !^\.well-known/
RewriteCond $1 !^backend/
RewriteCond $1 !^design/[^/]+/(css|js|images|fonts)/.+\.(css|js|map|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot)$ [NC]
RewriteCond $1 !^design/[^/]+/preview\.(png|jpe?g)$ [NC]
RewriteCond $1 !^cache/(css|js)/[^/]+\.(css|js)$ [NC]
RewriteCond $1 !^js_libraries/.+\.(css|js|map|png|jpe?g|gif|svg|webp|woff2?|ttf|eot)$ [NC]
RewriteCond $1 !^Okay/Modules/[^/]+/[^/]+/(Backend/)?design/.+\.(css|js|png|jpe?g|gif|svg|webp|woff2?|ttf)$ [NC]
RewriteCond $1 !^Okay/Modules/[^/]+/[^/]+/preview\.(png|jpe?g)$ [NC]
RewriteCond $1 !^files/.+\.(png|jpe?g|gif|svg|webp|ico|pdf|zip|xlsx?|docx?|csv|mp3|mp4|ogg|webm)$ [NC]
RewriteRule ^(.*)$ index.php [L,QSA]

# SVG, відкритий прямою навігацією, рендериться як документ і виконує
# вбудований <script>. Санітайзер підключений лише у файловому менеджері, тож
# скрипт глушиться заголовком. На <img src="...svg"> це не впливає.
<IfModule mod_headers.c>
    <FilesMatch "\.svg$">
        Header set Content-Security-Policy "default-src 'none'; sandbox"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>

# Редирект с повторяющихся слешей
RewriteCond %{REQUEST_URI} ^(.*)/{2,}(.*)$
RewriteRule ^(.*)$ %1/%2 [R=301,L]

# Редирект со слеша в конце на без него
#RewriteCond %{REQUEST_FILENAME} !-d
#RewriteCond %{REQUEST_URI} ^(.+)/$
#RewriteRule ^(.+)/$ %1 [R=301,L]

# Редирект с page-1 на основную страницу в ЧПУ
RewriteCond %{REQUEST_URI} ^(.*)/page-1(?![0-9])(.*)$
RewriteRule ^(.*)$ %1%3 [R=301,L]

# Редирект с page=1 на основную страницу без ЧПУ
RewriteCond %{QUERY_STRING} ^(.*)&?page=1(?![0-9])(.*)$
RewriteRule ^(.*)/?$ /$1?%1%3 [R=301,L]

# Админка теперь по адресу /backend
RewriteRule	^admin/?$  backend [L]

# Кэширование / поддерживается не на всех хостингах
<ifmodule mod_expires.c>
    <filesmatch "\.(jpg|jpeg|png|webp|svg|gif|js|css|swf|ico|woff|mp3)$">
        ExpiresActive on
        ExpiresDefault "access plus 7 days"
    </filesmatch>
</ifmodule>

# Gzip сжатие / поддерживается не на всех хостингах
<ifmodule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/css
    <ifmodule mod_setenvif.c>
        BrowserMatch ^Mozilla/4 gzip-only-text/html
        BrowserMatch ^Mozilla/4\.0[678] no-gzip
        BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
    </ifmodule>
</ifmodule>

# Google PageSpeed Insights модуль PageSpeed,есть не на всех хостингах и не везде может работать, нужно уточнять у хостеров
<IfModule pagespeed_module>
    ModPagespeed on
    ModPagespeedRewriteLevel CoreFilters
    ModPagespeedEnableFilters make_google_analytics_async
    ModPagespeedEnableFilters prioritize_critical_css
    ModPagespeedEnableFilters defer_javascript
    ModPagespeedEnableFilters sprite_images
    ModPagespeedEnableFilters convert_png_to_jpeg,convert_jpeg_to_webp
    ModPagespeedEnableFilters collapse_whitespace,remove_comments
</IfModule>

<IfModule mod_fcgid.c>
    # make HTTP Basic Authentication work on php-fcgi installs
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=REMOTE_USER:%{HTTP:Authorization}]
</IfModule>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule .* index.php [E=REMOTE_USER:%{HTTP:Authorization},L,QSA]
