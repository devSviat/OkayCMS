#php_flag display_errors on
#php_flag display_startup_errors on
#php_value session.cookie_httponly true
#php_value memory_limit 256M
AddDefaultCharset UTF-8
ErrorDocument 404 /404
RewriteEngine on
#RewriteBase /

# Лістинг видає структуру дерева навіть там, де кожен файл закритий.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ───────────────────────── Білий список ─────────────────────────
#
# Той самий підхід, що й у docs/nginx/nginx.conf: перелічене віддається, решта
# переписується на index.php — незалежно від того, чи файл є на диску. Раніше
# фінальне правило ловило лише неіснуючі шляхи (`!-f`), тож усе, що фізично
# лежить у дереві, віддавалось як є.
#
# Побічний ефект переписування: сторонній .php не виконується, бо mod_rewrite
# відпрацьовує до вибору обробника.
#
# Умови зіставляються з $1, а не з %{REQUEST_URI}: інакше встановлення в
# підкаталог (site.com/shop/) ламає кожне правило.

RewriteRule .*(\.git/|\.idea|\.gitignore).* - [F]
RewriteRule ^vendor/.* - [F]

# Дерева адмінки, які не є ані статикою, ані точками входу. 404, а не
# переписування: nginx тут теж віддає 404.
RewriteRule ^backend/(Controllers|Helpers|Requests|Entities)/ - [R=404,L]
RewriteRule ^backend/lang/ - [R=404,L]
RewriteRule ^backend/design/compiled/ - [R=404,L]
RewriteRule ^backend/design/js/filemanager/config/ - [R=404,L]

# Під backend/design/ — лише статика за розширенням і .php двох точок входу.
# Без цього віддавались .tpl, .htaccess і сміття вендорних JS-бібліотек.
# json тут немає навмисно: жоден шаблон його не просить, а package.json
# вендорної бібліотеки повідомляв її точну версію без авторизації.
RewriteCond $1 !\.(css|js|map|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot|html?)$ [NC]
RewriteCond $1 !^backend/design/js/(filemanager|admintooltip)/.+\.php$ [NC]
RewriteRule ^(backend/design/.*)$ index.php [L,QSA]

# Вихідні файли до ресайзу не публічні.
RewriteRule ^files/originals/ index.php [L,QSA]

# Усе, що не збіглося з жодним дозволом нижче, — у фронт-контролер.
RewriteCond $1 !^(robots\.txt|index\.php|favicon\.(ico|png|svg|gif|jpe?g|webp))$ [NC]
RewriteCond $1 !^\.well-known/
RewriteCond $1 !^backend/
RewriteCond $1 !^design/[^/]+/(css|js|images|fonts)/.+\.(css|js|map|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot)$ [NC]
RewriteCond $1 !^design/[^/]+/preview\.(png|jpe?g)$ [NC]
RewriteCond $1 !^cache/(css|js)/[^/]+\.(css|js)$ [NC]
RewriteCond $1 !^js_libraries/.+\.(css|js|map|png|jpe?g|gif|svg|webp|woff2?|ttf|eot)$ [NC]
RewriteCond $1 !^Okay/Modules/[^/]+/[^/]+/(Backend/)?design/.+\.(css|js|png|jpe?g|gif|svg|webp|woff2?|ttf)$ [NC]
RewriteCond $1 !^Okay/Modules/[^/]+/[^/]+/preview\.(png|jpe?g|gif|svg)$ [NC]
RewriteCond $1 !^files/.+\.(png|jpe?g|gif|svg|webp|ico|pdf|zip|xlsx?|docx?|csv|mp3|mp4|ogg|webm)$ [NC]
RewriteRule ^(.*)$ index.php [L,QSA]

<IfModule mod_headers.c>
    # Статику Apache віддає повз PHP, а серед дозволених розширень є html і svg.
    # setifempty, а не set: якщо застосунок уже виставив своє значення, воно
    # лишається.
    #
    # Версія перевіряється явно, бо setifempty зʼявився в Apache 2.4.7, а
    # невідомий аргумент директиви в .htaccess — це не попередження, а 500 на
    # кожен запит під цим каталогом. На старіших складаннях лишається set: він
    # перебиває значення, яке застосунок поклав у headers_out.
    #
    # Під CGI/FastCGI заголовки скрипта лягають у err_headers_out, куди дія
    # onsuccess не заглядає, — там обидві дії дадуть другий заголовок. На ці
    # три це не впливає: застосунок їх не виставляє власними значеннями.
    <IfModule mod_version.c>
        <IfVersion >= 2.4.7>
            Header setifempty X-Content-Type-Options "nosniff"
            Header setifempty X-Frame-Options "SAMEORIGIN"
            Header setifempty Referrer-Policy "strict-origin-when-cross-origin"
        </IfVersion>
        <IfVersion < 2.4.7>
            Header set X-Content-Type-Options "nosniff"
            Header set X-Frame-Options "SAMEORIGIN"
            Header set Referrer-Policy "strict-origin-when-cross-origin"
        </IfVersion>
    </IfModule>
    <IfModule !mod_version.c>
        Header set X-Content-Type-Options "nosniff"
        Header set X-Frame-Options "SAMEORIGIN"
        Header set Referrer-Policy "strict-origin-when-cross-origin"
    </IfModule>

    # SVG прямою навігацією рендериться як документ і виконує <script>.
    # Санітайзер є лише у файловому менеджері, тож глушимо заголовком.
    # На <img src="...svg"> це не впливає.
    <FilesMatch "\.svg$">
        Header set Content-Security-Policy "default-src 'none'; sandbox"
    </FilesMatch>
</IfModule>

# Редирект с повторяющихся слешей
RewriteCond %{REQUEST_URI} ^(.*)/{2,}(.*)$
RewriteRule ^(.*)$ %1/%2 [R=301,L]

# Редирект со слеша в конце на без него
#RewriteCond %{REQUEST_FILENAME} !-d
#RewriteCond %{REQUEST_URI} ^(.+)/$
#RewriteRule ^(.+)/$ %1 [R=301,L]

# Редирект с page-1 на основную страницу в ЧПУ
RewriteCond %{REQUEST_URI} ^(.*)/page-1(?![0-9])(.*)$
RewriteRule ^(.*)$ %1%3 [R=301,L]

# Редирект с page=1 на основную страницу без ЧПУ
RewriteCond %{QUERY_STRING} ^(.*)&?page=1(?![0-9])(.*)$
RewriteRule ^(.*)/?$ /$1?%1%3 [R=301,L]

# Админка теперь по адресу /backend
RewriteRule	^admin/?$  backend [L]

# Кэширование / поддерживается не на всех хостингах
<ifmodule mod_expires.c>
    <filesmatch "\.(jpg|jpeg|png|webp|svg|gif|js|css|swf|ico|woff|mp3)$">
        ExpiresActive on
        ExpiresDefault "access plus 7 days"
    </filesmatch>
</ifmodule>

# Gzip сжатие / поддерживается не на всех хостингах
<ifmodule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/css
    <ifmodule mod_setenvif.c>
        BrowserMatch ^Mozilla/4 gzip-only-text/html
        BrowserMatch ^Mozilla/4\.0[678] no-gzip
        BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
    </ifmodule>
</ifmodule>

# Google PageSpeed Insights модуль PageSpeed,есть не на всех хостингах и не везде может работать, нужно уточнять у хостеров
<IfModule pagespeed_module>
    ModPagespeed on
    ModPagespeedRewriteLevel CoreFilters
    ModPagespeedEnableFilters make_google_analytics_async
    ModPagespeedEnableFilters prioritize_critical_css
    ModPagespeedEnableFilters defer_javascript
    ModPagespeedEnableFilters sprite_images
    ModPagespeedEnableFilters convert_png_to_jpeg,convert_jpeg_to_webp
    ModPagespeedEnableFilters collapse_whitespace,remove_comments
</IfModule>

<IfModule mod_fcgid.c>
    # make HTTP Basic Authentication work on php-fcgi installs
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=REMOTE_USER:%{HTTP:Authorization}]
</IfModule>

# Лишається навмисно: після білого списку сюди доходять лише дозволені
# шляхи, яких ще немає на диску — files/resized/ створюється на перший запит.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule .* index.php [E=REMOTE_USER:%{HTTP:Authorization},L,QSA]
