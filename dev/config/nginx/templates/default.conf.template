# Рекомендована конфігурація Nginx для OkayCMS. Це не готове фінальне
# налаштування сервера — за тоншим тюнінгом зверніться до системного
# адміністратора.
#
# Назва файлу — default.conf.template — навмисна: entrypoint образу nginx
# розгортає /etc/nginx/templates/*.template у /etc/nginx/conf.d/ під тим самим
# іменем, тож цей файл заміщує штатний default.conf образу. Без цього штатний
# default.conf лишався б поруч, а його `server_name localhost` є точним збігом
# для http://localhost/ і виграв би в нашого віртуального хоста.
#
# default_server додано, щоб сайт відповідав на будь-який Host — localhost,
# 127.0.0.1, IP машини — а не лише на ${VIRTUAL_HOST}.
#
# ─────────────────────────── Білий список ───────────────────────────
#
# Корінь сайту — весь репозиторій: nginx-образ копіює дерево застосунку як є.
# Раніше конфіг був чорним списком — перелічував заборонене, — і тому був
# неповним за побудовою: будь-який новий файл у корені віддавався за
# замовчуванням. Так світились /vendor/composer/installed.json, /ok,
# /vendor/bin/phpunit, а PHP виконувався будь-де, де лежав .php, включно зі
# скомпільованими шаблонами Smarty (compiled/, backend/design/compiled/).
#
# Логіка перевернута. Тримається вона на одному рядку:
#
#     location / { try_files /does_not_exist /index.php?$args; }
#
# Кореневий location НЕ пробує віддати файл з диска ($uri тут навмисно немає),
# тож усе, що не дозволене явно нижче, іде у фронт-контролер і отримує 404
# застосунку. Заборона стала властивістю конструкції, а не довжиною переліку.
#
# Правило додавання: щоб опублікувати нове дерево статики, потрібен явний
# location. Щоб щось приховати — не потрібно нічого.

server {
    listen 80 default_server;
    server_name ${VIRTUAL_HOST};

    #add_header Strict-Transport-Security "max-age=31536000;";

    set $root_path /var/www/html;
    root $root_path;

    # Без цього nginx будує Location у редіректах як абсолютний URL із $host і
    # власним портом 80, і опублікований HTTP_PORT губиться — редірект іде в
    # нікуди щоразу, коли порт не 80.
    absolute_redirect off;

    charset off;
    index index.php;
    disable_symlinks if_not_owner from=$root_path;

    # Версія nginx у заголовку Server і на сторінках помилок — безкоштовна
    # підказка для добору відомих вразливостей.
    server_tokens off;

    # Логи йдуть у `docker compose logs nginx`, а не у файли робочого дерева.
    access_log /dev/stdout;
    error_log  /dev/stderr;

    gzip on;
    gzip_comp_level 9;
    gzip_disable "msie6";
    gzip_types text/plain text/css application/json application/x-javascript text/xml application/xml application/xml+rss text/javascript application/javascript;
    gzip_vary on;

    client_max_body_size 100M;

    if ($host ~* ^www\.(.*)$) {
        return 301 https://$server_name$request_uri;
    }

    if ($request_uri ~* "^(.*/)index\.php$") {
        return 301 $1;
    }

    if ($request_uri ~* "^(.*/)index\.html") {
        return 301 $1;
    }

    # ─────────────────────── Статика кореня ───────────────────────
    # Єдині файли, які віддаються з кореня репозиторію. Усе інше там —
    # composer.json, phpunit.xml, ok, README.md, сідові дампи — не є
    # застосунковими шляхами й тепер закрите за замовчуванням.

    location = /robots.txt {
        access_log off;
    }

    # Стандартний шлях ACME-валідації (Let's Encrypt).
    location ^~ /.well-known/ {
        access_log off;
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }

    # Дерево залежностей. Після інверсії воно й так недосяжне — під нього
    # немає жодного дозволу, — але правило лишається явним: ^~ виграє в будь-якої
    # регулярки, яку сюди додадуть пізніше, тож vendor/ не відкриється випадково
    # разом із новим дозволом «усі .js» чи «усі .css».
    location ^~ /vendor/ {
        return 404;
    }

    # ─────────────────────── Дерева статики ───────────────────────
    # Дозвіл описує і директорію, і розширення. Одного розширення мало:
    # у теми поруч із css/ лежать html/ з шаблонами, lang/ і js.php.

    location ~ ^/design/[^/]+/(css|js|images|fonts)/.+\.(?i:css|js|map|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot)$ {
        access_log off;
        expires max;
        add_header Cache-Control public;
        add_header Access-Control-Allow-Origin *;
    }

    # Прев'ю теми — перемикач тем в адмінці бере його прямо звідси.
    location ~ ^/design/[^/]+/preview\.(?i:png|jpe?g)$ {
        access_log off;
        expires max;
    }

    # Скомпільовані бандли css/js. Саме (css|js)/, а не весь cache/: поруч
    # лежить cache/codes/ і .map-файли з вихідними текстами бібліотек.
    location ~ ^/cache/(css|js)/[^/]+\.(?i:css|js)$ {
        access_log off;
        expires max;
        add_header Cache-Control public;
        add_header Access-Control-Allow-Origin *;
    }

    location ~ ^/js_libraries/.+\.(?i:css|js|map|png|jpe?g|gif|svg|webp|woff2?|ttf|eot)$ {
        access_log off;
        expires max;
        add_header Cache-Control public;
        add_header Access-Control-Allow-Origin *;
    }

    # Асети модулів. Потрібні: шаблони адмінки LiqPay, RozetkaPay, WayForPay,
    # FAQ і AutoDeploy беруть картинки й css прямо з Okay/Modules/.
    # Решта дерева Okay/ — вихідний код — не віддається.
    location ~ ^/Okay/Modules/[^/]+/[^/]+/(Backend/)?design/.+\.(?i:css|js|png|jpe?g|gif|svg|webp|woff2?|ttf)$ {
        access_log off;
        expires max;
    }

    # Прев'ю модуля лежить у його корені, а не під design/ — сторінка «Модулі»
    # в адмінці бере картинку саме звідти.
    location ~ ^/Okay/Modules/[^/]+/[^/]+/preview\.(?i:png|jpe?g)$ {
        access_log off;
        expires max;
    }

    # Завантаження файлового менеджера. originals/ — вихідні файли до
    # ресайзу, вони не публічні. Перелік розширень навмисно вузький: усе, що
    # браузер рендерить як HTML або віддає на виконання, тут дало б stored XSS
    # чи гірше на домені магазину.
    #
    # svg у переліку лишається — без нього не працюють іконки й логотипи, —
    # але сам по собі він небезпечний: відкритий прямою навігацією, SVG
    # рендериться як документ і виконує вбудований <script>. Санітайзер
    # (Okay\Core\Security\SvgSanitizer) підключений лише у файловому
    # менеджері, а зображення товарів ідуть повз нього (Okay/Core/Image.php),
    # тож покладатись на нього не можна. Скрипт усередині глушить CSP нижче:
    # на <img src="...svg"> вона не впливає, бо там скрипти й так не
    # виконуються.
    #
    # try_files з переходом на index.php обов'язковий: files/resized/ — це
    # маршрут (Okay/Core/config/routes.php), зменшені копії створюються на
    # перший запит. Жорсткий 404 тут ламав би кожну ще не згенеровану картинку.
    location ~ ^/files/(?!originals/).+\.(?i:png|jpe?g|gif|svg|webp|ico|pdf|zip|xlsx?|docx?|csv|mp3|mp4|ogg|webm)$ {
        try_files $uri /index.php?$args;
        access_log off;
        expires max;
        add_header Cache-Control public;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # ───────────────────────── Адмінка ─────────────────────────

    location = /admin {
        rewrite /admin /backend/ redirect;
    }

    location ^~ /backend/ {
        # Скомпільовані Smarty-шаблони адмінки — не точки входу. Досі кожен із
        # них виконувався як PHP і давав 500 з записом у лог.
        location ~ ^/backend/design/compiled/ {
            return 404;
        }

        location ~ ^/backend/lang/ {
            return 404;
        }

        # Класові дерева адмінки (PSR-4 Okay\Admin\ -> backend/) — не точки
        # входу. Кожен із 184 файлів досі виконувався прямим запитом: більшість
        # мовчки, AuthAdmin.php — фаталом і записом у лог.
        location ~ ^/backend/(Controllers|Helpers|Requests|Entities)/ {
            return 404;
        }

        # Конфіг файлового менеджера — облікові дані й шляхи.
        location ~ ^/backend/design/js/filemanager/config/ {
            return 404;
        }

        # PHP під backend/design/ виконується лише у двох деревах — це справжні
        # точки входу. js.php і css.php поруч із ними лише включаються з коду,
        # по HTTP їх ніхто не запитує.
        location ~ ^/backend/design/(?!js/(filemanager|admintooltip)/).*\.php$ {
            return 404;
        }

        location = /backend/design/js/admintooltip/admintooltip.js {
            rewrite ^(/backend/design/js/admintooltip)/admintooltip\.js$ $1/admintooltip.php break;
            try_files /does_not_exist @php;
        }

        location ^~ /backend/files/ {
            rewrite ^(/backend/files)/export/(.+)\.csv$ $1/index.php?file=$2&folder=export&ext=csv break;
            rewrite ^(/backend/files)/export_users/(.+)\.csv$ $1/index.php?file=$2&folder=export_users&ext=csv break;
            rewrite ^(/backend/files)/import/(.+)\.csv$ $1/index.php?file=$2&folder=import&ext=csv break;
            rewrite ^(/backend/files)/watermark/(.+)\.(png|jpg|jpeg|gif|tif|bmp|ico)$ $1/index.php?file=$2&folder=watermark&ext=$3 break;
            rewrite ^(\w+)$ /backend/files/index.php?file= break;
            try_files /does_not_exist @php;
        }

        location ~ \.ph(p\d*|tml)$ {
            try_files /does_not_exist @php;
        }

        # Статика адмінки — лише під design/ і лише за розширенням. Без цього
        # правила `try_files $uri` віддавав з диска все підряд: шаблони .tpl
        # (109 файлів), .htaccess, а разом із ними README, .sh, .yml, .editorconfig
        # і Thumbs.db зі складу вендорних JS-бібліотек.
        location ~ ^/backend/design/.+\.(?i:css|js|map|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot|html?|json)$ {
            try_files $uri =404;
        }

        # Усе інше в адмінці — фронт-контролер, без віддачі файлу з диска.
        # Той самий принцип, що й у кореневому location.
        try_files /does_not_exist /backend/index.php?$args;
    }

    # ──────────────────── Фронт-контролер вітрини ────────────────────

    location = /index.php {
        try_files /does_not_exist @php;
    }

    # $uri тут немає навмисно — див. коментар угорі файлу. Це і є білий список:
    # усе, що не дозволене вище, сюди й потрапляє, і файл з диска не віддається.
    location / {
        try_files /does_not_exist /index.php?$args;
    }

    location @php {
        fastcgi_pass ${FASTCGI}:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $request_filename;
        fastcgi_param DOCUMENT_ROOT $root_path;
        fastcgi_split_path_info ^((?U).+\.ph(?:p\d*|tml))(/?.+)$;
        fastcgi_buffering off;
        # Точна версія PHP у кожній відповіді. Джерело — expose_php у php.ini
        # (вимкнено в dev/config/php/), це другий рубіж для чужих хостингів.
        fastcgi_hide_header X-Powered-By;
        include fastcgi_params;
    }
}
