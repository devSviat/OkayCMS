# Рекомендована конфігурація Nginx для OkayCMS. Це не готове фінальне
# налаштування сервера — за тоншим тюнінгом зверніться до системного
# адміністратора.
#
# Назва файлу — default.conf.template — навмисна: entrypoint образу nginx
# розгортає /etc/nginx/templates/*.template у /etc/nginx/conf.d/ під тим самим
# іменем, тож цей файл заміщує штатний default.conf образу. Без цього штатний
# default.conf лишався б поруч, а його `server_name localhost` є точним збігом
# для http://localhost/ і виграв би в нашого віртуального хоста.
#
# default_server додано, щоб сайт відповідав на будь-який Host — localhost,
# 127.0.0.1, IP машини — а не лише на ${VIRTUAL_HOST}.
#
# ─────────────────────────── Білий список ───────────────────────────
#
# Корінь сайту — весь репозиторій: nginx-образ копіює дерево застосунку як є.
# Чорний список тут неповний за побудовою — так світились installed.json, /ok,
# /vendor/bin/phpunit, а PHP виконувався будь-де, де лежав .php.
#
# Тримається все на одному рядку:
#
#     location / { try_files /does_not_exist /index.php?$args; }
#
# $uri тут навмисно немає: усе, що не дозволене явно, іде у фронт-контролер.
# Щоб опублікувати нове дерево статики, потрібен явний location; щоб щось
# приховати — не потрібно нічого.

server {
    listen 80 default_server;
    server_name ${VIRTUAL_HOST};

    #add_header Strict-Transport-Security "max-age=31536000;";

    set $root_path /var/www/html;
    root $root_path;

    # Без цього nginx будує Location у редіректах як абсолютний URL із $host і
    # власним портом 80, і опублікований HTTP_PORT губиться — редірект іде в
    # нікуди щоразу, коли порт не 80.
    absolute_redirect off;

    charset off;
    index index.php;
    disable_symlinks if_not_owner from=$root_path;

    # Версія nginx у Server і на сторінках помилок — підказка для сканерів.
    server_tokens off;

    # Логи йдуть у `docker compose logs nginx`, а не у файли робочого дерева.
    access_log /dev/stdout;
    error_log  /dev/stderr;

    gzip on;
    gzip_comp_level 9;
    gzip_disable "msie6";
    gzip_types text/plain text/css application/json application/x-javascript text/xml application/xml application/xml+rss text/javascript application/javascript;
    gzip_vary on;

    client_max_body_size 100M;

    if ($host ~* ^www\.(.*)$) {
        return 301 https://$server_name$request_uri;
    }

    if ($request_uri ~* "^(.*/)index\.php$") {
        return 301 $1;
    }

    if ($request_uri ~* "^(.*/)index\.html") {
        return 301 $1;
    }

    # ─────────────────────── Статика кореня ───────────────────────
    # Єдині файли, які віддаються з кореня репозиторію.
    #
    # Захисні заголовки — у кожному локейшені, що віддає файл із диска: серед
    # дозволених розширень є html і svg, тож документи сюди теж потрапляють, а
    # SecurityHeaders до них не доходить. На рівні server не спрацює —
    # add_header у локейшені замінює успадковані, а не додається до них.

    location = /robots.txt {
        access_log off;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Стандартний шлях ACME-валідації (Let's Encrypt).
    location ^~ /.well-known/ {
        access_log off;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Не лише .ico: сучасні теми кладуть у корінь favicon.svg або .png.
    location ~ ^/favicon\.(?i:ico|png|svg|gif|jpe?g|webp)$ {
        access_log off;
        log_not_found off;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Після інверсії воно й так недосяжне, але правило лишається явним:
    # ^~ виграє в будь-якої регулярки, яку сюди додадуть пізніше.
    location ^~ /vendor/ {
        return 404;
    }

    # ─────────────────────── Дерева статики ───────────────────────
    # Дозвіл описує і директорію, і розширення: у теми поруч із css/ лежать
    # html/ з шаблонами, lang/ і js.php.

    location ~ ^/design/[^/]+/(css|js|images|fonts)/.+\.(?i:css|js|map|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot)$ {
        access_log off;
        expires max;
        add_header Cache-Control public;
        add_header Access-Control-Allow-Origin *;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Прев'ю теми — перемикач тем в адмінці бере його прямо звідси.
    location ~ ^/design/[^/]+/preview\.(?i:png|jpe?g)$ {
        access_log off;
        expires max;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Саме (css|js)/, а не весь cache/: поруч лежить cache/codes/ і .map.
    location ~ ^/cache/(css|js)/[^/]+\.(?i:css|js)$ {
        access_log off;
        expires max;
        add_header Cache-Control public;
        add_header Access-Control-Allow-Origin *;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location ~ ^/js_libraries/.+\.(?i:css|js|map|png|jpe?g|gif|svg|webp|woff2?|ttf|eot)$ {
        access_log off;
        expires max;
        add_header Cache-Control public;
        add_header Access-Control-Allow-Origin *;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Шаблони адмінки беруть картинки й css прямо з Okay/Modules/.
    # Решта дерева Okay/ — вихідний код — не віддається.
    location ~ ^/Okay/Modules/[^/]+/[^/]+/(Backend/)?design/.+\.(?i:css|js|png|jpe?g|gif|svg|webp|woff2?|ttf)$ {
        access_log off;
        expires max;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Прев'ю модуля лежить у його корені, а не під design/. Перелік розширень
    # мусить збігатися з Module::fileHasAllowImageExtension() — інакше ядро
    # віддає в шаблон шлях, який nginx не обслуговує, і в списку модулів
    # адмінки висить бита картинка.
    #
    # svg тут, як і в /files/ нижче, прямою навігацією рендериться як документ
    # і виконує <script>, а прев'ю кладе в репозиторій автор модуля. Тому та
    # сама CSP: на <img src="…svg"> вона не впливає.
    location ~ ^/Okay/Modules/[^/]+/[^/]+/preview\.(?i:png|jpe?g|gif|svg)$ {
        access_log off;
        expires max;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Завантаження файлового менеджера; originals/ не публічні. Перелік
    # розширень вузький: усе, що браузер рендерить як HTML або віддає на
    # виконання, дало б тут stored XSS.
    #
    # svg лишається заради іконок, але прямою навігацією виконує <script>, а
    # санітайзер підключений лише у файловому менеджері (зображення товарів
    # ідуть повз нього). Тому CSP нижче; на <img src="...svg"> вона не впливає.
    #
    # try_files на index.php обов'язковий: files/resized/ — це маршрут
    # (Okay/Core/config/routes.php), копії створюються на перший запит.
    location ~ ^/files/(?!originals/).+\.(?i:png|jpe?g|gif|svg|webp|ico|pdf|zip|xlsx?|docx?|csv|mp3|mp4|ogg|webm)$ {
        try_files $uri /index.php?$args;
        access_log off;
        expires max;
        add_header Cache-Control public;
        add_header Content-Security-Policy "default-src 'none'; sandbox" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # ───────────────────────── Адмінка ─────────────────────────

    location = /admin {
        rewrite /admin /backend/ redirect;
    }

    location ^~ /backend/ {
        # Скомпільовані Smarty-шаблони — не точки входу; кожен виконувався
        # як PHP і давав 500 з записом у лог.
        location ~ ^/backend/design/compiled/ {
            return 404;
        }

        location ~ ^/backend/lang/ {
            return 404;
        }

        # Класові дерева (PSR-4 Okay\Admin\ -> backend/) — не точки входу.
        # Кожен із 184 файлів виконувався прямим запитом.
        location ~ ^/backend/(Controllers|Helpers|Requests|Entities)/ {
            return 404;
        }

        # Конфіг файлового менеджера — облікові дані й шляхи.
        location ~ ^/backend/design/js/filemanager/config/ {
            return 404;
        }

        # PHP під backend/design/ — лише два дерева справжніх точок входу.
        # js.php і css.php поруч включаються з коду, по HTTP їх не запитують.
        location ~ ^/backend/design/(?!js/(filemanager|admintooltip)/).*\.php$ {
            return 404;
        }

        location = /backend/design/js/admintooltip/admintooltip.js {
            rewrite ^(/backend/design/js/admintooltip)/admintooltip\.js$ $1/admintooltip.php break;
            try_files /does_not_exist @php;
        }

        location ^~ /backend/files/ {
            rewrite ^(/backend/files)/export/(.+)\.csv$ $1/index.php?file=$2&folder=export&ext=csv break;
            rewrite ^(/backend/files)/export_users/(.+)\.csv$ $1/index.php?file=$2&folder=export_users&ext=csv break;
            rewrite ^(/backend/files)/import/(.+)\.csv$ $1/index.php?file=$2&folder=import&ext=csv break;
            rewrite ^(/backend/files)/watermark/(.+)\.(png|jpg|jpeg|gif|tif|bmp|ico)$ $1/index.php?file=$2&folder=watermark&ext=$3 break;
            rewrite ^(\w+)$ /backend/files/index.php?file= break;
            try_files /does_not_exist @php;
        }

        location ~ \.ph(p\d*|tml)$ {
            try_files /does_not_exist @php;
        }

        # Статика адмінки — лише під design/ і лише за розширенням. Без цього
        # `try_files $uri` віддавав .tpl, .htaccess і сміття вендорних
        # JS-бібліотек (README, .sh, .yml, Thumbs.db).
        # json тут немає навмисно: жоден шаблон його не просить, а package.json
        # вендорної бібліотеки повідомляв її точну версію без авторизації.
        location ~ ^/backend/design/.+\.(?i:css|js|map|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot|html?)$ {
            try_files $uri =404;
            add_header X-Content-Type-Options nosniff always;
            add_header X-Frame-Options SAMEORIGIN always;
            add_header Referrer-Policy strict-origin-when-cross-origin always;
        }

        # Усе інше — фронт-контролер, без віддачі файлу з диска.
        try_files /does_not_exist /backend/index.php?$args;
    }

    # ──────────────────── Фронт-контролер вітрини ────────────────────

    location = /index.php {
        try_files /does_not_exist @php;
    }

    # $uri тут немає навмисно — див. коментар угорі файлу.
    location / {
        try_files /does_not_exist /index.php?$args;
    }

    location @php {
        fastcgi_pass ${FASTCGI}:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $request_filename;
        fastcgi_param DOCUMENT_ROOT $root_path;
        fastcgi_split_path_info ^((?U).+\.ph(?:p\d*|tml))(/?.+)$;
        fastcgi_buffering off;
        # Джерело — expose_php у php.ini; це другий рубіж для чужих хостингів.
        fastcgi_hide_header X-Powered-By;
        include fastcgi_params;
    }
}
