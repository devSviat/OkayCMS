# Конфігурація FrankenPHP (Caddy) для OkayCMS.
#
# Модель — білий список: запитаний шлях не перевіряється на диску, і все, що не
# дозволене явно, іде у фронт-контролер останнім рядком. Щоб опублікувати нове
# дерево, потрібен явний матчер; щоб приховати — не потрібно нічого.
#
# Звідси й відмова від php_server: він вмикає file_server і try_files, тобто
# віддає будь-який наявний файл. Гола php небезпечна так само — вона виконує
# запитаний шлях, тож стоїть лише після rewrite на точку входу або під матчером,
# що звужує до неї.
#
# Порядок усередині route{} — це порядок виконання, і header серед директив теж.
# Go RE2 не має негативного lookahead, тож винятки виражаються лише порядком.
#
# Паритет із docs/nginx/nginx.conf стережуть tests/Security/CaddyfileRulesTest.php
# і PublicSurfaceTest.php, свідомі розбіжності описані в
# docs/deployment-frankenphp.md.

{
	auto_https off
	frankenphp

	# Адмін-API слухає 127.0.0.1:2019 за замовчуванням, а вебсервер і PHP тут —
	# один процес під одним UID: код застосунку дістав би до POST /load і замінив
	# конфігурацію в памʼяті в обхід білого списку. У репозиторії API не
	# використовує ніщо.
	admin off

	servers {
		# X-Forwarded-* приймаються лише від проксі у приватних мережах.
		trusted_proxies static private_ranges
	}
}

# Порт непривілейований: no-new-privileges у compose блокує file capabilities,
# тож setcap CAP_NET_BIND_SERVICE для non-root не працює. Адреса без хоста —
# аналог `listen 80 default_server`.
:8080 {
	root * /var/www/html

	encode zstd gzip

	# Аналог client_max_body_size.
	request_body {
		max_size 100MB
	}

	# Логи в `docker compose logs`, а не у файли робочого дерева.
	log {
		output stdout
	}

	# `?` — «лише якщо ще не задано»: на PHP-відповідях трійку вже виставив
	# SecurityHeaders. X-Powered-By глушиться ще й через expose_php=Off.
	header {
		-Server
		-X-Powered-By
		?X-Content-Type-Options nosniff
		?X-Frame-Options SAMEORIGIN
		?Referrer-Policy strict-origin-when-cross-origin
	}

	# Помилки file_server пишуться повз обробник header вище, тож заголовки
	# знімаються ще раз: Server видає сервер, а кеш-заголовки дерев статики
	# змусили б кеші памʼятати відсутній файл рік.
	handle_errors {
		header -Server
		header -Cache-Control
		header -Access-Control-Allow-Origin
		header -Content-Security-Policy
		respond "" {err.status_code}
	}

	route {
		# ────────────────────────── Ліміт тіла ──────────────────────────
		#
		# max_size рве читання на ліміті, а не відхиляє запит — тіло приходить у
		# застосунок мовчки обрізаним. Звідси явна 413 за оголошеною довжиною;
		# для chunked обрізання лишається.
		#
		# Порожній рядок перевіряється першим: без Content-Length гола int("")
		# дає помилку обчислення, і кожна відповідь стає 500. validate не ловить.
		@too_large expression {http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 100000000
		respond @too_large 413

		# ───────────────────────── Редіректи ─────────────────────────

		# Схема й хост беруться з запиту, тож порт не губиться.
		@www header_regexp www Host ^(?i:www\.)(.+)$
		redir @www {http.request.scheme}://{re.www.1}{uri} 301

		# Умова на порожній query обов'язкова: path_regexp не бачить рядка
		# запиту, і без неї редірект зрізав би параметри — зокрема на
		# ?controller=AuthAdmin, куди ядро шле неавторизованого менеджера.
		# (?i) — канонізація не зважає на регістр, інакше /INDEX.PHP це другий
		# URL на ту саму сторінку.
		@index_php {
			path_regexp idxphp (?i)^(.*/)index\.php$
			expression {http.request.uri.query} == ""
		}
		redir @index_php {re.idxphp.1} 301

		@index_html path_regexp idxhtml (?i)^(.*/)index\.html
		redir @index_html {re.idxhtml.1} 301

		# Сумісність зі старим URL адмінки.
		redir /admin /backend/ temporary

		# ───────────────────────── Заборони ─────────────────────────
		#
		# Перед будь-яким дозволом.
		@denied path /vendor/* /backend/lang/* /backend/design/compiled/*
		respond @denied 404

		# Оригінали не віддаються, але це не серверна 404: магазин малює власну
		# сторінку. Стоїть перед правилом files/ — виняток тримається порядком.
		route /files/originals/* {
			rewrite * /index.php
			php
		}

		# Класові дерева (PSR-4 Okay\Admin\ -> backend/) — не точки входу.
		@denied_psr4 path_regexp ^/backend/(Controllers|Helpers|Requests|Entities)/
		respond @denied_psr4 404

		# ─────────────────────── Статика кореня ───────────────────────

		@robots path /robots.txt
		file_server @robots

		# Шлях ACME-валідації для зовнішнього проксі.
		@wellknown path /.well-known/*
		file_server @wellknown

		# Не лише .ico: сучасні теми кладуть у корінь favicon.svg або .png.
		@favicon path_regexp ^/favicon\.(?i:ico|png|svg|gif|jpe?g|webp)$
		file_server @favicon

		# ─────────────────────── Дерева статики ───────────────────────
		#
		# Дозвіл описує і директорію, і розширення: у теми поруч із css/ лежать
		# html/ з шаблонами, lang/ і js.php.

		@theme_static path_regexp ^/design/[^/]+/(css|js|images|fonts)/.+\.(?i:css|js|map|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot)$
		header @theme_static {
			Cache-Control "public, max-age=31536000"
			Access-Control-Allow-Origin *
		}
		file_server @theme_static

		# Прев'ю теми — перемикач тем в адмінці бере його прямо звідси.
		@theme_preview path_regexp ^/design/[^/]+/preview\.(?i:png|jpe?g)$
		header @theme_preview Cache-Control "public, max-age=31536000"
		file_server @theme_preview

		# Саме (css|js)/, а не весь cache/: поруч лежить cache/codes/ і .map.
		@cache_bundles path_regexp ^/cache/(css|js)/[^/]+\.(?i:css|js)$
		header @cache_bundles {
			Cache-Control "public, max-age=31536000"
			Access-Control-Allow-Origin *
		}
		file_server @cache_bundles

		@js_libraries path_regexp ^/js_libraries/.+\.(?i:css|js|map|png|jpe?g|gif|svg|webp|woff2?|ttf|eot)$
		header @js_libraries {
			Cache-Control "public, max-age=31536000"
			Access-Control-Allow-Origin *
		}
		file_server @js_libraries

		# Шаблони адмінки беруть картинки й css прямо з Okay/Modules/; решта
		# дерева — вихідний код — не віддається.
		@module_static path_regexp ^/Okay/Modules/[^/]+/[^/]+/(Backend/)?design/.+\.(?i:css|js|png|jpe?g|gif|svg|webp|woff2?|ttf)$
		header @module_static Cache-Control "public, max-age=31536000"
		file_server @module_static

		# Перелік розширень мусить збігатися з
		# Module::fileHasAllowImageExtension(), інакше в списку модулів адмінки
		# висить бита картинка. CSP — бо svg прямою навігацією виконує <script>,
		# а прев'ю кладе в репозиторій автор модуля.
		@module_preview path_regexp ^/Okay/Modules/[^/]+/[^/]+/preview\.(?i:png|jpe?g|gif|svg)$
		header @module_preview {
			Cache-Control "public, max-age=31536000"
			Content-Security-Policy "default-src 'none'; sandbox"
		}
		file_server @module_preview

		# Перелік розширень вузький: усе, що браузер рендерить як HTML або
		# виконує, дало б тут stored XSS. svg лишається заради іконок, але
		# санітайзер підключений лише у файловому менеджері — звідси CSP.
		#
		# try_files обов'язковий: files/resized/ — маршрут, копії створюються на
		# перший запит. header стоїть після php: інакше кеш-заголовки й CSP
		# лягають і на HTML-фолбек зі Set-Cookie.
		@files path_regexp ^/files/.+\.(?i:png|jpe?g|gif|svg|webp|ico|pdf|zip|xlsx?|docx?|csv|mp3|mp4|ogg|webm)$
		route @files {
			try_files {path} /index.php
			@files_front path /index.php
			php @files_front
			header {
				Cache-Control "public, max-age=31536000"
				Content-Security-Policy "default-src 'none'; sandbox"
			}
			file_server
		}

		# ───────────────────────── Адмінка ─────────────────────────

		# Єдина точка входу PHP під backend/design/. Перед забороною .php і перед
		# статикою: .js інакше віддався б файлом з диска.
		route /backend/design/js/admintooltip/admintooltip.js {
			rewrite * /backend/design/js/admintooltip/admintooltip.php
			php
		}

		# Решта .php під backend/design/ — не точки входу: js.php і css.php
		# включаються з коду, по HTTP їх не запитують.
		@backend_design_php path_regexp ^/backend/design/.*\.php$
		respond @backend_design_php 404

		# Службові файли — лише через PHP-гейт: виконується рівно одна точка
		# входу, решта 404.
		route /backend/files/* {
			@export path_regexp exp ^/backend/files/export/(.+)\.csv$
			rewrite @export /backend/files/index.php?file={re.exp.1}&folder=export&ext=csv

			@export_users path_regexp expu ^/backend/files/export_users/(.+)\.csv$
			rewrite @export_users /backend/files/index.php?file={re.expu.1}&folder=export_users&ext=csv

			@import path_regexp imp ^/backend/files/import/(.+)\.csv$
			rewrite @import /backend/files/index.php?file={re.imp.1}&folder=import&ext=csv

			@watermark path_regexp wm ^/backend/files/watermark/(.+)\.(png|jpg|jpeg|gif|tif|bmp|ico)$
			rewrite @watermark /backend/files/index.php?file={re.wm.1}&folder=watermark&ext={re.wm.2}

			@backend_files_entry path /backend/files/index.php
			php @backend_files_entry
			respond 404
		}

		# Шаблони адмінки звертаються до цих скриптів напряму. Матчер звужений до
		# однієї теки й одного сегмента — нове дерево точок входу вимагатиме
		# явного правила. `file` обов'язковий: без нього php пробує виконати
		# відсутній скрипт і пише фатал у лог на будь-яке ім'я.
		@backend_ajax {
			path_regexp ^/backend/ajax/[^/]+\.php$
			file
		}
		php @backend_ajax

		# Лише під design/ і лише за розширенням, інакше віддаються .tpl,
		# .htaccess і сміття вендорних бібліотек. json виключений навмисно:
		# package.json повідомляє точну версію бібліотеки без авторизації.
		@backend_static path_regexp ^/backend/design/.+\.(?i:css|js|map|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|eot|html?)$
		file_server @backend_static

		# Саме /backend/*, без голого /backend: той іде у фронт-контролер вітрини
		# і дає 404, як і в nginx.
		route /backend/* {
			rewrite * /backend/index.php
			php
		}

		# ──────────────── Фронт-контролер вітрини ────────────────
		#
		# Шлях не перевіряється на диску — див. шапку файлу.
		rewrite * /index.php
		php
	}
}
