# Перейменувати в .env та налаштувати. Правити лише на зупинених контейнерах.
# "Унікальний" — серед усіх docker compose, запущених одночасно на цій машині.

# Унікальний хост, також додати його у файл hosts.
VIRTUAL_HOST=okaycms.loc
# Унікальний на машині. Для кількох проєктів — від 60000 з кроком 10.
HTTP_PORT=80

# Унікальне ім'я проєкту, щоб контейнери різних проєктів не пересіклися.
APP_NAME=OkayCmsDev
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=okay
MYSQL_PASSWORD=root

# Унікальний на машині. Для кількох проєктів — від 65000 з кроком 10.
MYSQL_PORT=3306

# Пошта, на яку перенаправляються всі листи. Порожньо — йдуть за призначенням.
TEST_INTERNAL_EMAIL=""

# Домен production-версії (з протоколом), звідки довантажуються оригінали
# зображень під ресайзи.
PRODUCTION_DOMAIN=""

# Мають збігатися з хостовим користувачем (`id -u` / `id -g`), інакше
# bind-mounted файли будуть без права запису.
APP_UID=1000
APP_GID=1000

# Інтерфейс, на який публікуються порти. 0.0.0.0 — лише якщо навмисно потрібен
# доступ з іншої машини.
BIND_IP=127.0.0.1

# off | debug | develop | profile (через кому для кількох). Діє без перезбирання.
XDEBUG_MODE=off

# FrankenPHP worker mode. Типові значення нижче — classic mode, він і
# лишається режимом за замовчуванням. Обидві змінні вмикаються разом:
#
#   FRANKENPHP_CONFIG="worker /var/www/html/worker.php 4"
#   OKAY_FRONT_ENTRY=/worker.php
#
# Перша оголошує воркер і кількість потоків, друга спрямовує в нього вітрину.
# Адмінка, /backend/ajax/ і статика лишаються classic у будь-якому разі.
FRANKENPHP_CONFIG=""
OKAY_FRONT_ENTRY=/index.php

# Скільки запитів обробляє воркер до перезапуску. Запобіжник від витоків
# пам'яті: 0 — без обмеження. У classic mode не діє.
MAX_REQUESTS=1000

# Для init-скрипта. Сам застосунок у dev ходить у базу під root —
# див. config/config.local.php.
MYSQL_USER=okay

TZ=Europe/Kyiv
# 0 — не дозволяти db-init перезаписувати SMTP-налаштування на Mailpit.
DB_INIT_SMTP=1

# Веб-інтерфейс Mailpit. Тут осідають усі листи сайту, жоден не йде далі.
MAILPIT_PORT=8025
