# Файл перейменувати в .env та налаштувати
# Правити тільки коли docker контейнери не запущені
# ПРИМІТКА під "унікальний..." мається з усіх запущених docker compose.
# Якщо завжди запущене лише одне оточення, то можна щоб в різних проектах вони пересікалися

# Унікальний хост, також додати його в файл hosts
VIRTUAL_HOST=okaycms.loc
# Порт http сервера (унікальний з усіх запущених docker compose на машині)
# Якщо проектів буде кілька, рекомендую починати з 60000 і +10 на кожному наступному проекті
HTTP_PORT=80

# Унікальне ім'я проекту, щоб контейнери з інших проектів не пересіклися з цим
APP_NAME=OkayCmsDev
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=okay
MYSQL_PASSWORD=root

# Порт MySQL сервера (унікальний з усіх запущених docker compose на машині)
# Якщо проектів буде кілька, рекомендую починати з 65000 і +10 на кожному наступному проекті
MYSQL_PORT=3306

# Ім'я мережі, в якій працюють контейнери. Зазвичай змінювати не треба
NETWORK_NAME=okay_network

# Пошта, на яку будуть перенаправлятися всі листи. Якщо пусто - листи ітимуть на адресу призначення
TEST_INTERNAL_EMAIL=""

# Домен production версії сайту. Використовується для викачування зображень ресайзів etc.
# Писати з протоколом (https://demookay.com/)
PRODUCTION_DOMAIN=""

# Uid/gid the container's www-data is mapped to. Must match your host user
# (`id -u` / `id -g`), otherwise bind-mounted files come out unwritable.
APP_UID=1000
APP_GID=1000

# Interface the published ports bind to. 127.0.0.1 keeps the database and the
# site off the local network; set to 0.0.0.0 only if you deliberately want
# another machine to reach them.
BIND_IP=127.0.0.1

# Xdebug: off | debug | develop | profile (comma-separated for several).
# Takes effect on `docker compose up -d`, no rebuild needed.
XDEBUG_MODE=off

# Database account the init script uses. The application itself connects as root
# in dev — see config/config.local.php.
MYSQL_USER=okay

TZ=Europe/Kyiv
# Set to 0 to stop db-init from rewriting the SMTP settings to point at Mailpit.
DB_INIT_SMTP=1

# Mailpit web UI. Every message the site sends is caught here and none leave the
# machine, which is a stronger guarantee than TEST_INTERNAL_EMAIL's redirect.
MAILPIT_PORT=8025
