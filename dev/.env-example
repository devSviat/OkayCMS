# Файл перейменувати в .env та налаштувати.
# Правити лише коли контейнери docker зупинені.
# "Унікальний" нижче означає: унікальний серед усіх docker compose,
# запущених одночасно на цій машині.

# Унікальний хост, також додати його у файл hosts.
VIRTUAL_HOST=okaycms.loc
# Порт http-сервера, унікальний на машині. Для кількох проєктів зручно
# рахувати від 60000 з кроком 10.
HTTP_PORT=80

# Унікальне ім'я проєкту, щоб контейнери різних проєктів не пересіклися.
APP_NAME=OkayCmsDev
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=okay
MYSQL_PASSWORD=root

# Порт MySQL-сервера, унікальний на машині. Для кількох проєктів зручно
# рахувати від 65000 з кроком 10.
MYSQL_PORT=3306

# Пошта, на яку перенаправляються всі листи. Якщо порожньо — листи йдуть на
# адресу призначення.
TEST_INTERNAL_EMAIL=""

# Домен production-версії сайту (з протоколом, напр. https://demookay.com/).
# Використовується для довантаження оригіналів зображень під ресайзи тощо.
PRODUCTION_DOMAIN=""

# Uid/gid, під якими в контейнері працює www-data. Мають збігатися з хостовим
# користувачем (`id -u` / `id -g`), інакше bind-mounted файли будуть без
# права запису.
APP_UID=1000
APP_GID=1000

# Інтерфейс, на який публікуються порти. 127.0.0.1 тримає базу й сайт поза
# локальною мережею; 0.0.0.0 — лише якщо навмисно потрібен доступ з іншої машини.
BIND_IP=127.0.0.1

# Xdebug: off | debug | develop | profile (через кому для кількох режимів).
# Діє одразу після `docker compose up -d`, без перезбирання образу.
XDEBUG_MODE=off

# Обліковий запис БД для init-скрипта. Сам застосунок у dev ходить у базу під
# root — див. config/config.local.php.
MYSQL_USER=okay

TZ=Europe/Kyiv
# 0 — не дозволяти db-init перезаписувати SMTP-налаштування на Mailpit.
DB_INIT_SMTP=1

# Веб-інтерфейс Mailpit. Тут осідають усі листи сайту, жоден не йде далі —
# надійніше за просто редірект TEST_INTERNAL_EMAIL.
MAILPIT_PORT=8025
