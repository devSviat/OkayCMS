includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    # Запис baseline, який більше ні на що не вказує, прогін не валить:
    # видалена або переписана помилка не має вимагати правки конфіга.
    #
    # Зворотний бік цим НЕ покривається: якщо правка додає в описаному файлі
    # помилку, якої в baseline немає, або той самий шаблон починає збігатися
    # частіше за записану кількість - це звичайні помилки, і прогін впаде.
    # Тобто baseline лишається прив'язаним до стану дерева, і після злиття
    # гілок, що правлять уже описані файли, його треба перегенерувати.
    reportUnmatchedIgnoredErrors: false
    paths:
        - Okay
        - backend
    excludePaths:
        - Okay/Modules/*/vendor/*
        - backend/design/js/filemanager/*
        - backend/design/compiled/*
        - Okay/xml/compiled/*
    bootstrapFiles:
        - vendor/autoload.php
