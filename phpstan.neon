includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    # Запис у baseline, що більше ні на що не вказує, не валить прогін.
    # Без цього baseline стає чутливим до порядку злиття гілок: правка, яка
    # зсуває рядки у вже описаному файлі, ламає збірку в іншій гілці, хоча
    # нової помилки ніхто не вносив. Ціна - застарілі записи тихо лишаються;
    # прибираються перегенерацією baseline.
    reportUnmatchedIgnoredErrors: false
    paths:
        - Okay
        - backend
    excludePaths:
        - Okay/Modules/*/vendor/*
        - backend/design/js/filemanager/*
        - backend/design/compiled/*
        - Okay/xml/compiled/*
    bootstrapFiles:
        - vendor/autoload.php
